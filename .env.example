# Run history store (optional).
# Without these, history is kept in-process and is lost on restart / cold start.
# On Vercel: add the "Upstash for Redis" integration (Storage tab) and these are
# injected for you. KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
