# Run history store (optional).
# Without this, history is kept in-process and is lost on restart / cold start.
#
# On Vercel: Storage tab → create/connect a Redis store to the project. Vercel
# injects REDIS_URL automatically — nothing to paste here. Then redeploy.
#
# Locally: `vercel env pull .env.development.local` to pull it, or set it yourself:
REDIS_URL=
